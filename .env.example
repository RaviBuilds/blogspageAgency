# Copy to .env.local and fill in real values. Never commit .env.local itself.

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_PROJECT_ID=""
# Write access (drafts, publishing scripts). Server-side only — never exposed
# to the client, never prefixed with NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=""

# --- Google Analytics 4 ---
# Public GA4 Measurement ID (format: G-XXXXXXXXXX). This is a public tracking
# identifier, not a secret, but it still must be set per-environment so
# local/dev/preview builds don't send traffic into production analytics.
# Loaded globally in src/app/layout.tsx via
# src/components/providers/google-analytics.tsx. Leaving this unset disables
# GA4 entirely (safe no-op) rather than loading a broken tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-MCQPBR4P88"

# --- Other integrations ---
WP_API_URL="https://blogspage.com/wp-json/wp/v2"
OPENAI_API_KEY=""
